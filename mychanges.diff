+    char aExtraName[MAX_NAME_LENGTH];
+    str_format(aExtraName, sizeof(aExtraName), "[E] %s", Client()->PlayerName());
+    for(int i = 0; i < MAX_CLIENTS; i++)
+    {
+        if(m_aClients[i].m_Active && str_comp(m_aClients[i].m_aName, aExtraName) == 0)
+            return i;
+    }
+    return -1;
